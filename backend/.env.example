# Copy to .env (or export in your shell). Placeholders only — never commit real secrets.
OPSTWIN_ENV=development
OPSTWIN_DATABASE_URL=sqlite:///./opstwin.db
OPSTWIN_CORS_ORIGINS=http://localhost:5173
# Secure cookies need HTTPS; defaults to true outside development.
# OPSTWIN_COOKIE_SECURE=true
OPSTWIN_SESSION_HOURS=8
OPSTWIN_SESSION_IDLE_MINUTES=60
OPSTWIN_LOGIN_MAX_FAILURES=5
OPSTWIN_LOGIN_LOCKOUT_MINUTES=15
OPSTWIN_CHANGE_REQUEST_TTL_HOURS=24
# Used by `python -m app.seed --demo`; leave empty to generate one and print it once.
OPSTWIN_DEMO_PASSWORD=
# Used by `python -m app.seed --create-admin you@example.edu`
OPSTWIN_ADMIN_PASSWORD=
